# AI Molecules in the Clinic — environment for the corrections API (api/)
# Real values live in Vercel project env. Copy to .env for local work; never commit .env.
DATABASE_URL=            # Neon aixbio-registry, least-privilege app role
RESEND_API_KEY=          # sending from aixbio-registry.org
CORRECTIONS_NOTIFY_TO=   # where new-submission alerts go
ADMIN_PASSWORD=          # review page
IP_HASH_SALT=            # random; hashes submitter IPs for rate limiting
CORRECTIONS_FROM=        # e.g. AI Molecules in the Clinic <corrections@aixbio-registry.org>
SITE_URL=                # https://aixbio-registry.org
